log_format mycelia_safe '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';

server {
    # Override the image's inherited combined log rather than adding a second
    # http-level log that would leave the original query-bearing log enabled.
    access_log /var/log/nginx/access.log mycelia_safe;
    # Runtime hostname resolution uses whatever DNS the container runtime gave
    # us (Docker's 127.0.0.11, Podman's own, ...), read from /etc/resolv.conf by
    # the entrypoint. Do not hardcode a list: nginx round-robins across the
    # servers instead of failing over, so one unreachable address stalls every
    # request that lands on it for the full 5s DNS resend interval.
    resolver ${NGINX_RESOLVER} ipv6=off valid=30s;
    listen 80 default_server;
    listen 443 ssl http2 default_server;
    listen 4433 ssl http2 default_server;

    server_name _;

    # Generated by the entrypoint: production redirects cleartext HTTP;
    # APP_MODE=dev explicitly keeps local HTTP available.
    ${NGINX_HTTP_REDIRECT}

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "camera=(), geolocation=(self), microphone=(self)" always;

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    # Minimal sane defaults for SSL
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Allow larger uploads (voice samples, audio files)
    client_max_body_size 512M;

    # Variables for upstream hosts (forces runtime DNS resolution)
    set $frontend_upstream "http://frontend:8080";
    set $backend_upstream "http://backend:5173";

    # Consent has a browser page (GET/HEAD) and a protected action (POST).
    location = /oauth/consent {
        set $consent_upstream $backend_upstream;
        if ($request_method ~ ^(GET|HEAD)$) {
            set $consent_upstream $frontend_upstream;
        }
        proxy_pass $consent_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Backend routes
    location ~ ^/(ws|api|auth|data|oauth|llm|v1|mcp|health|readiness|\.well-known) {
        proxy_pass $backend_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Long-lived streams: chat SSE can be silent for minutes while a slow
        # model thinks, and websockets idle between events. The default 60s
        # read timeout kills both mid-stream (client sees "network error"
        # while the backend finishes and persists the reply).
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        # Deliver SSE chunks immediately instead of buffering them
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # Everything else to frontend
    location / {
        proxy_pass $frontend_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
