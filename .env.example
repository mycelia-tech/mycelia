# ==============================================================================
# MYCELIA CONFIGURATION
# ==============================================================================
#
# Quick Start:
#   ./scripts/setup.sh --start     # Creates .env, generates secrets, starts services
#
# After Updates:
#   ./scripts/check-env.sh --all   # Audit every configured env contract
#
# Legend:
#   [AUTO]     - Auto-generated by setup.sh (don't edit manually)
#   [OPTIONAL] - Has sensible defaults, only set if you need to customize
#   [CLI-ONLY] - Only needed for Python daemon/CLI access (not web UI)
#
# ==============================================================================

# ==============================================================================
# BACKEND SERVICE URLS
# ==============================================================================

# MYCELIA_URL - Backend service URL
# Used by: backend/env.ts, workers (transcription, summarization, conversationExtractor, etc.)
# Purpose: Internal backend API base URL for worker jobs and service communication
MYCELIA_URL=https://localhost:4433

# MYCELIA_FRONTEND_HOST - Frontend service URL
# Used by: backend/env.ts, backend/app/routes/oauth.authorize.ts
# Purpose: Frontend URL for OAuth redirects and CORS configuration
MYCELIA_FRONTEND_HOST=https://localhost:4433

# Allow self-signed certificates
ALLOW_INSECURE_TRANSPORT=false

# Host-side audio discovery overrides. These are read by python/settings.py
# when the ingestion daemon or CLI runs directly on the host.
#
# Apple modes:
#   manual - background Apple discovery is disabled (safe default)
#   staged - read only explicit local staging ROOT/DB paths; recommended for launchd
#   live   - opt-in direct access to Apple's protected Group Container
MYCELIA_APPLE_VOICEMEMOS_MODE=manual
# MYCELIA_APPLE_VOICEMEMOS_ROOT=
# Separate CloudRecordings.db or read-only snapshot; required in staged mode.
# MYCELIA_APPLE_VOICEMEMOS_DB=
# Timezone-aware ISO cutoff; required by the bounded local staging publisher
# and optional for direct manual/live discovery.
# MYCELIA_APPLE_VOICEMEMOS_NOT_BEFORE=
# MYCELIA_GOOGLE_DRIVE_ROOT=
# MYCELIA_LOCAL_AUDIO_ROOT=
# MYCELIA_GOOGLE_TZ=UTC
# MYCELIA_LOCAL_TZ=UTC

# NGINX_PORT - NGINX reverse proxy port (external HTTPS)
# Used by: docker-compose.yml (nginx service port mapping)
# Purpose: External port for HTTPS access (typically 4433)
NGINX_PORT=4433
# Optional plain-HTTP entry point used by local tools and secondary frontends.
# NGINX_HTTP_PORT=3210

# ==============================================================================
# DOCKER CONFIGURATION [OPTIONAL] - have sensible defaults in docker-compose.yml
# ==============================================================================

# APP_MODE - Application runtime mode (default: prod)
# Used by: docker-compose.yml (frontend Dockerfile/tag and backend task)
# Options:
#   - prod: nginx static frontend and stable backend without a watcher
#   - dev: Vite HMR frontend and backend file watcher
# Changing this value requires rebuilding frontend, recreating frontend/backend,
# and restarting nginx. Dev/prod frontend images keep separate tags.
# Apply a changed mode with:
# docker compose build frontend && docker compose up -d --no-deps --force-recreate frontend backend && docker compose restart nginx
APP_MODE=prod

# ==============================================================================
# OPTIONAL PHOTO/PDF KNOWLEDGE MOUNTS FOR THE MAIN UAT STACK
# ==============================================================================
# Used only when docker-compose.media-uat.yml is appended to the normal UAT
# Compose command. Both values must be absolute host paths. The source folder
# and Google ADC file are mounted read-only and must already exist; Compose will
# fail before recreating backend if either path is missing.
MEDIA_SOURCE_HOST_PATH=
GCP_ADC_HOST_PATH=
# Optional external library: append docker-compose.media-external.yml after the
# UAT overlays. Connect the disk first; preserve its folder name across recreates.
# MEDIA_SOURCE_EXTRA_HOST_PATH=
# MEDIA_SOURCE_EXTRA_NAME=external-photos
# For removable disks on macOS, prefer docker-compose.media-disks.yml instead.
# It mounts the stable parent read-only; individual disks are optional at startup.
# MEDIA_DISKS_HOST_PATH=/Volumes
# Optional stable aliases relative to MEDIA_SOURCE_ROOT; names reserve root entries.
# MEDIA_SOURCE_ALIASES='{"icloud-backup":"disks/MyDisk/Source/iCloud_backup"}'

# Optional colon-separated Compose overlays for the local deployment.
# COMPOSE_FILE=docker-compose.yml:docker-compose.media-uat.yml

# Optional credential for an explicitly configured self-hosted Media Knowledge
# profile. Google Cloud profiles use ADC above and do not use an API key here.
# MEDIA_SELF_HOSTED_API_KEY=

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================

# SECRET_KEY [AUTO] - Session encryption key
# Auto-generated by: ./scripts/setup.sh (using openssl rand -hex 32)
# Used by: backend/env.ts, backend/app/lib/auth/core.server.ts, backend/app/lib/auth/tokens.ts
# Purpose: Encrypts sessions, JWT tokens, and sensitive data
#
# IMPORTANT: Do not use the placeholder value in production!
# The setup script generates a secure random key automatically.
#
# CHANGING THIS KEY: You CAN change it, but be aware:
#   - All existing user sessions will be invalidated (users logged out)
#   - All active JWT tokens will stop working
#   - Any data encrypted with the old key becomes unreadable
SECRET_KEY=

# MYCELIA_CLIENT_ID [CLI-ONLY] - OAuth client ID
# Used by: python/lib/config.py, python/recorder/recorder.py
# Purpose: Required for Python daemon and CLI access (not needed for web UI)
# Generate: ./scripts/setup.sh --with-tokens OR visit /setup page in browser
# Note: Web UI stores credentials in browser, these are only for external scripts
MYCELIA_CLIENT_ID=

# MYCELIA_TOKEN [CLI-ONLY] - API authentication token
# Used by: python/lib/api.py, python/recorder/recorder.py
# Purpose: Required for Python daemon and CLI access (not needed for web UI)
# Generate: ./scripts/setup.sh --with-tokens OR visit /setup page in browser
MYCELIA_TOKEN=

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# DATABASE_NAME - MongoDB database name
# Used by: backend/env.ts, backend/app/lib/mongo/core.server.ts, backend/app/lib/mongo/fs.server.ts
# Purpose: Name of the MongoDB database to use
DATABASE_NAME=mycelia

# Database Volume Paths
# Leave unset to use Docker named volumes (default)
# To use custom paths, uncomment and set these variables:
# MONGO_HOST_PATH=~/.mycelia/data/mongo
# REDIS_HOST_PATH=~/.mycelia/data/redis

# MONGO_URL - MongoDB connection string
# Used by: backend/env.ts, backend/app/lib/mongo/core.server.ts
# Purpose: Full MongoDB connection URL (with host, port, and connection options)
MONGO_URL=mongodb://mongo:27017?directConnection=true

# MONGO_INITDB_ROOT_USERNAME - MongoDB root username
# Used by: docker-compose.yml (mongo service), misc/mongo/mongo-entrypoint.sh
# Purpose: Root admin username for MongoDB initialization
MONGO_INITDB_ROOT_USERNAME=root

# MONGO_INITDB_ROOT_PASSWORD - MongoDB root password
# Used by: docker-compose.yml (mongo service), misc/mongo/mongo-entrypoint.sh
# Purpose: Root admin password for MongoDB initialization
MONGO_INITDB_ROOT_PASSWORD=

# ==============================================================================
# OPTIONAL QDRANT RAG PROJECTION
# ==============================================================================
# The vector index runs as a separate Compose project from
# `docker-compose.rag.yml`. The backend client is lazy: Mycelia still starts
# when the RAG service is stopped, while Search/Knowledge reports unavailable.
#
# Docker backend -> standalone host-published RAG API. For a backend running
# directly on the host, use http://127.0.0.1:48091 instead.
# RAG_URL=http://host.docker.internal:48091
# RAG_REQUEST_TIMEOUT_MS=15000

# Optional service-to-service token. When set, use the same value in the main
# `.env` and the standalone `.env.rag.local`. Never commit the real value.
# RAG_INTERNAL_TOKEN=

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================

# REDIS_PASSWORD - Redis authentication password
# Used by: backend/env.ts, backend/app/lib/redis.ts, docker-compose.yml (redis service)
# Purpose: Password for Redis connection (job queue, pub/sub, caching)
# NOTE: Must match between backend service and redis service in docker-compose.yml
REDIS_PASSWORD=

# REDIS_HOST - Redis server hostname (set by docker-compose.yml)
# Used by: backend/env.ts, backend/app/lib/redis.ts
# Default: localhost (overridden to 'redis' in docker-compose.yml)

# REDIS_PORT - Redis server port (set by docker-compose.yml)
# Used by: backend/env.ts, backend/app/lib/redis.ts
# Default: 6379

# ==============================================================================
# PYTHON WORKER INTEGRATION
# ==============================================================================

# PYTHON_WORKER_URL - Python worker service URL (set by docker-compose.yml)
# Used by: backend/env.ts, backend/workers (diarization, vad)
# Purpose: Base URL for Python worker API endpoints (ML/AI processing)
# Default: http://localhost:8000 (overridden to http://python-worker:8000 in docker-compose.yml)

# INGESTION_WORKER_URL - host ingestion service URL as seen from Docker
# Source files stay on the host; do not route ingestion to python-worker.
INGESTION_WORKER_URL=http://host.docker.internal:8001

# Seconds between automatic host discovery/ingestion cycles.
INGESTION_INTERVAL_SECONDS=10

# ==============================================================================
# TELEMETRY & OBSERVABILITY (OpenTelemetry)
# ==============================================================================

# Mycelia's OpenTelemetry SDK is disabled unless explicitly enabled. Do not add
# Deno's separate built-in telemetry flags here; running two exporters would
# duplicate telemetry.
OTEL_ENABLED=false
# OTEL_SERVICE_NAME=mycelia
# OTEL_RESOURCE_ATTRIBUTES=service.version=1.0.0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_CONSOLE_TRACES=false
# OTEL_CONSOLE_METRICS=false

# Advanced diagnostics. Leave disabled during normal operation.
# LOG_HTTP=false
# DEBUG_REQUESTS=false
# DEBUG_ACCESS_LOG=false
# DEBUG_AUDIO_WS=false

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================

# LOG_LEVEL - Application logging verbosity
# Used by: Python services (not currently used in backend)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Job Queue Configuration (TEST/DEBUG ONLY)
# Enable fast mode for job triggers (reduces debounce/interval for testing)
# WARNING: Do not enable in production - uses aggressive timing for testing
# JOB_TRIGGERS_FAST=true

# Override job debounce time in milliseconds (TEST/DEBUG ONLY)
# JOB_DEBOUNCE_MS=

# Override job interval in seconds (TEST/DEBUG ONLY)
# JOB_INTERVAL_SECONDS=

# Transcription Configuration
# Language code for transcription (default: "auto")
# Set this to prevent faster-whisper language detection failures with short audio
# TRANSCRIPTION_LANGUAGE=auto

# Number of ready transcription sequences processed in one worker job (1-32).
# While Whisper transcribes one sequence, the next sequence is fetched and
# converted to WAV so the GPU can start the next request without an IO gap.
# TRANSCRIPTION_BATCH_SIZE=16
# Keep false for the stable one-sequence-per-job GPU pacing. Set true to enable
# multi-sequence jobs and audio prefetching.
# TRANSCRIPTION_BATCHING_ENABLED=false

# STT_SERVER_URL - Dedicated remote OpenAI-compatible STT endpoint used by the
# automatic backend pipeline and by python/stt.py
# Portainer is an admin UI; use the proxy's published host/Tailscale URL here.
# Example: http://gpu-host.example:8001
# STT_SERVER_URL=

# PROXY_API_KEY - Bearer token for STT_SERVER_URL
# Generate the same value for the GPU stack with: openssl rand -hex 32
# PROXY_API_KEY=

# STT_MODEL - Model requested by the automatic pipeline and python/stt.py.
# The generic "whisper" alias accepts whichever model the server has loaded.
# The Mycelia Portainer proxy reports its actual ASR_MODEL automatically.
# STT_MODEL=large-v3-turbo

# Model Configuration
# Configure the same values in Settings -> Inference, or override them here.
# OPENAI_BASE_URL and OPENAI_API_KEY select the OpenAI-compatible LLM provider.
# OPENAI_MODEL is the provider default used by legacy aliases and background
# workers. OPENAI_CHAT_MODEL sets the model inherited by new memory chats.
# OPENAI_BASE_URL=http://your-llm-server:8080/v1
# OPENAI_API_KEY=replace-me
# OPENAI_MODEL=your-local-model.gguf
#
# OpenRouter prompt cache routing is enabled by default. Mycelia sends stable
# session IDs for extraction and summarization so OpenRouter can keep those
# requests on one provider with a warm prompt cache. Set false to disable it.
# OPENROUTER_PROMPT_CACHING=true
# OPENROUTER_SESSION_PREFIX=mycelia
# OPENAI_CHAT_MODEL=your-local-model.gguf
# LLM_REQUEST_TIMEOUT_MS=240000

# Legacy provider-wide fallback is opt-in and disabled by default. Prefer the
# per-feature fallback settings in Settings -> Inference below.
OPENAI_FALLBACK_ENABLED=false
# OPENAI_FALLBACK_MODEL=

# Per-feature fallback models. Leave empty/unset to stop with an error instead
# of silently changing models. The web settings store the same policies as
# worker defaults and take precedence for newly enqueued jobs.
# SUMMARIZATION_FALLBACK_MODEL=
# CONVERSATION_EXTRACTION_FALLBACK_MODEL=
# TAGGER_FALLBACK_MODEL=
# ENTITY_TYPING_FALLBACK_MODEL=

# Legacy hard override for small/medium/large aliases. Explicit model choices,
# including per-chat choices, remain explicit. Prefer OPENAI_MODEL or
# Settings -> Inference for new installations.
# BASE_MODEL=gpt-4o

# Model Alias Configuration
# Map model size aliases (small/medium/large) to actual model names
# If not set, aliases use OPENAI_MODEL / the UI global default.
# MODEL_SMALL=gpt-4o-mini
# MODEL_MEDIUM=gpt-4o
# MODEL_LARGE=gpt-4o

# ==============================================================================
# BACKUP (Percona Backup for MongoDB) [OPTIONAL]
# ==============================================================================
# Current supported host workflow: docs/BACKUP.md and .env.backup.example.
# The legacy PBM profile is experimental and remains disabled by default.
# Do not enable it as a substitute for the verified restic file workflow.
# PITR architecture and deployment prerequisites:
# docs/superpowers/plans/2026-09-30-mycelia-pbm-pitr.md

# PBM_USER - PBM agent MongoDB username (must be created in MongoDB first)
# PBM_PASSWORD - PBM agent MongoDB password
# Provisioning/authentication is part of the separate PBM deployment plan.
# PBM_USER=pbmuser
# PBM_PASSWORD=change-me-please

# PBM_BACKUP_HOST_PATH - Host path for filesystem backups
# Leave unset to use Docker named volume (default)
# PBM_BACKUP_HOST_PATH=~/backups/mycelia-mongo-backup

# ==============================================================================
# GPU SERVICES (Remote Inference)
# ==============================================================================

# DIARIZATION_SERVER_URL - Remote diarization service URL
# Used by: python/diarization_worker.py
# Purpose: Speaker diarization and voice identification
# Setup: Deploy gpu/ services on a machine with NVIDIA GPU, then set the URL
# DIARIZATION_SERVER_URL=http://gpu-machine-ip:8085

# Local diarizator profile settings. Remote providers configure these on the
# provider host instead of in Mycelia's client environment.
# SPEAKER_SERVICE_HOST=0.0.0.0
# SPEAKER_SERVICE_PORT=8085
# DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# EMBEDDING_MODEL=pyannote/wespeaker-voxceleb-resnet34-LM
# DIARIZATION_MODEL_REVISION=
# EMBEDDING_MODEL_REVISION=
# AUDIO_BACKEND=soundfile

# DIARIZATION_MAX_SEQUENCE_CHUNKS - Consecutive 10-second chunks per request
# Keep the main Compose default (2) for a memory-limited local CPU service.
# A 24 GiB remote GPU pool should start with 8 and benchmark before raising it.
# DIARIZATION_MAX_SEQUENCE_CHUNKS=8

# DIARIZATION_RECORDING_LEASE_SECONDS - Expiring ownership of one source
# recording while a diarization job prepares and processes its sequences.
# Keep this above the provider read timeout; 600 seconds is the safe default.
# DIARIZATION_RECORDING_LEASE_SECONDS=600

# DIARIZATION_PREFETCH_SEQUENCES - Prepare at most one next WAV while the
# current provider request runs. Start at 0, then canary 1 after leases and
# stage timings are verified. Values above 1 are rejected.
# DIARIZATION_PREFETCH_SEQUENCES=0

# Remote Pyannote GPU batching. These are consumed by the diarizator image,
# normally through Portainer stack variables rather than the Mycelia worker.
# DIARIZATION_SEGMENTATION_BATCH_SIZE=8
# DIARIZATION_EMBEDDING_BATCH_SIZE=8
# DIARIZATION_SEGMENT_EMBEDDING_BATCH_SIZE=4
# DIARIZATION_REQUEST_CONCURRENCY=1
# DIARIZATION_MAX_QUEUED_REQUESTS=1
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# HF_TOKEN - Hugging Face access token
# Used by: Diarization service for PyAnnote model access
# Get your token: https://huggingface.co/settings/tokens
# Required if running diarization locally (not via remote GPU)
# HF_TOKEN=hf_your_token_here

# SPEAKER_SIMILARITY_THRESHOLD - Threshold for speaker matching (default: 0.35)
# Used by: python/diarization_worker.py, python/jobs/speaker_matching.py
# Range: 0.0 to 1.0 (higher = stricter matching, fewer false positives)
# SPEAKER_SIMILARITY_THRESHOLD=0.35

# DIARIZATION_CONTINUITY_THRESHOLD - Match request-local speakers across overlapping windows
# Used by: python/diarization_worker.py
# Range: 0.0 to 1.0 (default: 0.75; higher reduces incorrect cross-window merges)
# DIARIZATION_CONTINUITY_THRESHOLD=0.75

# Maximum silence between source chunks joined into one request sequence.
# DIARIZATION_MAX_GAP_SECONDS=60
