def resolve(value):
    if value in {str(i) for i in range(1, len(MODELS) + 1)}:
        return MODELS[int(value) - 1]
    key = ALIASES.get(value, value)
    for model in MODELS:
        if model.key == key:
            return model
    raise ValueError(f"Unknown model: {value}. Use qwen-switch list.")


def preflight(model):
    if not model.compose:
        if inspect(model) is None:
            raise RuntimeError(f"Container {model.container} is missing; legacy profiles are not created automatically.")
        return
    path = ROOT / model.compose
    if not path.is_file():
        raise RuntimeError(f"Compose file not found: {path}")
    run("docker", "compose", "-f", str(path), "config", "-q")
    config = json.loads(run("docker", "compose", "-f", str(path), "config", "--format", "json").stdout)
    for network in (config.get("networks") or {}).values():
        if network.get("external"):
            run("docker", "network", "inspect", network["name"], "--format", "{{.Id}}")
    service = config["services"]["llama"]
    if service.get("container_name") != model.container:
        raise RuntimeError("Compose container_name does not match the selected profile.")
    run("docker", "image", "inspect", service["image"], "--format", "{{.Id}}")
    args = service["command"]
    mounts = {mount["target"]: mount["source"] for mount in service.get("volumes", []) if mount.get("type") == "bind"}
    for flag in ("--model", "--mmproj"):
        if flag == "--mmproj" and flag not in args:
            continue
        remote = arg_value(args, (flag,), "")
        if not remote.startswith("/models/") or "/models" not in mounts:
            raise RuntimeError(f"Expected /models bind mount not found for {flag}.")
        local = Path(mounts["/models"]) / remote.removeprefix("/models/")
        if not local.is_file() or local.stat().st_size == 0:
            raise RuntimeError(f"Model/projector file is missing or empty: {local}")
    draft = arg_value(args, ("--spec-draft-model",), "")
    if draft:
        # The shared draft's parent is not user-readable. Check only this exact
        # read-only file through Docker before stopping the current profile.
        mount = next((item for item in service.get("volumes", [])
                      if item.get("type") == "bind" and item["target"] == draft), None)
        if not mount or not mount.get("read_only"):
            raise RuntimeError("Draft model requires an exact-file read-only bind mount.")
        run("docker", "run", "--rm", "--pull", "never", "--network", "none", "--read-only",
            "--entrypoint", "/bin/sh", "--mount",
            f"type=bind,source={mount['source']},target=/draft.gguf,readonly",
            service["image"], "-ec", "test -f /draft.gguf && test -r /draft.gguf && test -s /draft.gguf")


def ensure_idle(model, force):
    if force:
        return
    props = api(model, "/props")
    if isinstance(props, dict) and props.get("is_sleeping") is True:
        return
    slots = api(model, "/slots")
    if isinstance(slots, list) and slots and all("is_processing" in slot for slot in slots):
        if any(slot["is_processing"] for slot in slots):
            raise RuntimeError(f"{model.key} is processing a request. Wait for completion; --force will interrupt it.")
        return
    metrics = api(model, "/metrics", raw=True)
    if metrics:
        matches = re.findall(r"^[^#\n]*requests_processing(?:\{[^}]*\})?\s+([0-9.eE+-]+)\s*$", metrics, re.M)
        if matches:
            if any(float(value) > 0 for value in matches):
                raise RuntimeError(f"{model.key} is processing a request. Wait for completion; --force will interrupt it.")
            return
    raise RuntimeError(f"Cannot verify active requests for {model.key}; switch cancelled. Use --force only to intentionally interrupt.")


def set_restart(model, policy):
    run("docker", "update", f"--restart={policy}", model.container)


def policy_string(info):
    policy = info["restart"]
    name = policy.get("Name") or "no"
    retries = policy.get("MaximumRetryCount", 0)
    return f"{name}:{retries}" if name == "on-failure" and retries else name


def wait_ready(model, timeout):
    started = time.monotonic()
    next_report = started
    while time.monotonic() - started < timeout:
        info = inspect(model)
        if not is_running(info):
            raise RuntimeError(f"{model.key}: container exited before readiness. See docker logs {model.container}")
        label, props = status(model, info)
        if label in ("LOADED", "API READY"):
            if model.compose:
                ctx = (props or {}).get("default_generation_settings", {}).get("n_ctx")
                path = (props or {}).get("model_path", "")
                expected_context = model.runtime_context or model.context
                if ctx != expected_context or Path(path).name != model.model_filename:
                    raise RuntimeError(f"API does not match profile {model.key}: context={ctx}, model={path}")
            print(f"Ready: {model.key} - {label}")
            return
        if label == "SLEEPING":
            print("Model is sleeping; waking it with a short local request...")
            remaining = max(1, timeout - (time.monotonic() - started))
            result = api(model, "/completion", {"prompt": "Hello", "n_predict": 1, "stream": False}, timeout=remaining)
            if result is None:
                raise RuntimeError("Model wake-up did not complete successfully.")
            continue
        if time.monotonic() >= next_report:
            print(f"Waiting for {model.key} to load... {int(time.monotonic() - started)} s", flush=True)
            next_report = time.monotonic() + 10
        time.sleep(1)
    raise RuntimeError(f"{model.key}: model did not become ready within {timeout} seconds.")


@contextmanager
def locked():
    # Fixed project-local lock: all callers use the same file. No global Docker operations.
    fd = os.open(LOCK, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o660)
    with os.fdopen(fd, "w") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RuntimeError("Another qwen-switch is already switching profiles.") from exc
        yield


def switch_to(target, force=False, timeout=180, dry_run=False, *, lock_held=False):
    with (nullcontext() if lock_held else locked()):
        preflight(target)
        snapshot = {model.key: inspect(model) for model in MODELS}
        previous = [model for model in MODELS if is_running(snapshot[model.key])]
        if len(previous) > 1:
            raise RuntimeError("Multiple known models are running; run qwen-switch stop first.")
        if previous == [target]:
            if dry_run:
                print(f"Already running: {target.key}. No changes.")
            else:
                wait_ready(target, timeout)
            return
        for model in previous:
            ensure_idle(model, force)
        print(f"Selected: {SHORT_NAMES[target.key]}")
        print("Stop: " + (", ".join(model.key for model in previous) or "nothing"))
        if not target.compose:
            print("Warning: legacy DFlash settings are unchanged; use upstream for images.")
        if dry_run:
            print("DRY RUN: preflight passed; containers unchanged.")
            return
        try:
            for model in MODELS:
                if snapshot[model.key]:
                    set_restart(model, "no")
            for model in previous:
                print(f"Stopping {model.key}...", flush=True)
                run("docker", "stop", "-t", "30", model.container, timeout=45)
            print(f"Starting {target.key}...", flush=True)
            if target.compose:
                run("docker", "compose", "-f", str(ROOT / target.compose), "up", "-d", "--pull", "never", "--no-build", "llama", timeout=90)
            else:
                run("docker", "start", target.container)
            set_restart(target, "unless-stopped")
            wait_ready(target, timeout)
        except (Exception, KeyboardInterrupt):
            print("Start failed/interrupted. Restoring the previous profile...", file=sys.stderr, flush=True)
            try:
                if inspect(target):
                    set_restart(target, "no")
                    if is_running(inspect(target)):
                        run("docker", "stop", "-t", "30", target.container, timeout=45)
                for model in MODELS:
                    if snapshot[model.key]:
                        set_restart(model, policy_string(snapshot[model.key]))
                for model in previous:
                    run("docker", "start", model.container)
                    wait_ready(model, timeout)
            except Exception as rollback_error:
                print(f"WARNING: rollback incomplete: {rollback_error}", file=sys.stderr)
            raise
        print(f"API: http://127.0.0.1:{target.port}/v1")
        https_port = 8444 if target.port == 8082 else 8443
        print(f"Tailscale: https://bastion.cheetah-cod.ts.net:{https_port}/v1")


