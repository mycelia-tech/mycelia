def file_diarization_health(info):
    if not is_running(info):
        return None
    for network in (info.get("networks") or {}).values():
        address = network.get("IPAddress")
        if not address:
            continue
        try:
            # Probe the selected container directly, never another service bound to :8085.
            with OPENER.open(f"http://{address}:8085/health", timeout=2) as response:
                data = json.load(response)
            return data if isinstance(data, dict) else None
        except (OSError, ValueError, urllib.error.URLError):
            continue
    return None


def file_diarization_ready(data):
    return bool(isinstance(data, dict) and data.get("service") == "pyannote-diarization"
                and data.get("status") == "ok" and data.get("ready") is True
                and str(data.get("device", "")).startswith("cuda")
                and type(data.get("concurrency")) is int and data["concurrency"] == 1
                and type(data.get("maxQueued")) is int and 0 <= data["maxQueued"] <= 1)


def wait_file_diarization(timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        info = inspect(FILE_DIARIZATION)
        if not is_running(info) or info["state"].get("Restarting"):
            raise RuntimeError("File diarization stopped or restarted during startup")
        data = file_diarization_health(info)
        if file_diarization_ready(data):
            print("File diarization API READY on :8085 (GPU); audio quality is a separate check.")
            return
        time.sleep(1)
    raise RuntimeError("File diarization readiness timeout; no successful /health ready=true GPU response")


def control_file_diarization(action, force=False, timeout=180, dry_run=False):
    if action not in ("start", "stop"):
        raise ValueError("File diarization supports start or stop")
    with locked():
        guard_disk()
        before = inspect(FILE_DIARIZATION)
        if before is None:
            raise RuntimeError("File diarization container is missing; no candidate replicas are started automatically")
        was_running = is_running(before)
        if action == "stop":
            if not was_running:
                print("File diarization is already stopped.")
                return
            if dry_run:
                print("DRY RUN: gracefully stop only " + FILE_DIARIZATION.container)
            else:
                graceful_stop(FILE_DIARIZATION, timeout, force)
                print("File diarization stopped; other services unchanged.")
            return
        if was_running:
            if dry_run:
                print("DRY RUN: file diarization is already running; no changes.")
            else:
                wait_file_diarization(timeout)
            return
        conflicts = run("docker", "ps", "--filter", "publish=8085", "--format", "{{.Names}}", timeout=10).stdout.splitlines()
        conflicts = [name for name in conflicts if name and name != FILE_DIARIZATION.container]
        if conflicts:
            raise RuntimeError("Port 8085 is already owned by another container: " + ", ".join(conflicts))
        guard_file_start(force)
        if dry_run:
            print("DRY RUN: would start only " + FILE_DIARIZATION.container + "; Qwen/audio/candidate replicas and restart policies unchanged.")
            return
        try:
            run("docker", "start", FILE_DIARIZATION.container)
            wait_file_diarization(timeout)
        except (Exception, KeyboardInterrupt):
            # The selected service was stopped before this request; restore only it.
            try:
                result = run("docker", "stop", "--timeout=-1", FILE_DIARIZATION.container, timeout=timeout, check=False)
                after = inspect(FILE_DIARIZATION)
                if result.returncode or after is None or is_running(after):
                    print("WARNING: file diarization rollback incomplete; inspect " + FILE_DIARIZATION.container, file=sys.stderr)
            except Exception as rollback_error:
                print("WARNING: file diarization rollback incomplete: " + str(rollback_error), file=sys.stderr)
            raise



def live_cpu_only(info):
    env = (info or {}).get("env") or {}
    return (env.get("CUDA_VISIBLE_DEVICES") == ""
            and env.get("NVIDIA_VISIBLE_DEVICES") in ("void", "none", "")
            and not (info or {}).get("devices"))


def file_bounded(info):
    env = (info or {}).get("env") or {}
    limits = {"DIARIZATION_SEGMENTATION_BATCH_SIZE": 8,
              "DIARIZATION_EMBEDDING_BATCH_SIZE": 8,
              "DIARIZATION_SEGMENT_EMBEDDING_BATCH_SIZE": 4}
    try:
        # These defaults match the deployed service; actual admission limits
        # are checked again from /health before reporting the service ready.
        bounded = (all(0 < int(env.get(key, 0)) <= limit for key, limit in limits.items())
                   and int(env.get("DIARIZATION_REQUEST_CONCURRENCY", 1)) == 1
                   and 0 <= int(env.get("DIARIZATION_MAX_QUEUED_REQUESTS", 1)) <= 1)
    except (TypeError, ValueError):
        return False
    if not bounded:
        return False
    return not is_running(info) or file_diarization_ready(file_diarization_health(info))


def service_health(service, info=None):
    info = info if info is not None else inspect(service)
    if not is_running(info):
        return None
    port = 8000 if service.key == "wlk" else 9000
    for network in (info.get("networks") or {}).values():
        address = network.get("IPAddress")
        if not address:
            continue
        try:
            with OPENER.open(f"http://{address}:{port}/health", timeout=2) as response:
                data = json.load(response)
            return data if isinstance(data, dict) else None
        except (OSError, ValueError, urllib.error.URLError):
            continue
    return None


def guard_free_vram(minimum_mib, label, force=False):
    if force:
        return
    result = run("nvidia-smi", "--query-gpu=memory.free", "--format=csv,noheader,nounits", timeout=10)
    try:
        free = float(result.stdout.splitlines()[0])
    except (ValueError, IndexError) as error:
        raise RuntimeError("Cannot measure GPU headroom for " + label) from error
    if not math.isfinite(free) or free < minimum_mib:
        raise RuntimeError(f"{label} needs >= {minimum_mib / 1024:g} GiB current free VRAM; measured {free:g} MiB")


def guard_file_start(force=False):
    large = [m for m in MODELS if m.key != "small" and is_running(inspect(m))]
    if not force and large:
        if (len(large) != 1 or large[0].key != "uncensored-asr"
                or not file_bounded(inspect(FILE_DIARIZATION))):
            raise RuntimeError("File diarization requires bounded batches and the 27B/32K ASR profile; choose big-audio or audio")
    guard_free_vram(2048, "File diarization", force)



class DrainInProgress(RuntimeError):
    """Shutdown was requested but must not be undone by automatic rollback."""


def live_connections():
    if not is_running(inspect(AUDIO[-1])):
        return 0
    code = ("from pathlib import Path; import json; "
            "print(json.dumps(sum(1 for p in ('/proc/net/tcp','/proc/net/tcp6') "
            "if Path(p).exists() for l in Path(p).read_text().splitlines()[1:] "
            "if l.split()[1].split(':')[-1].upper()=='1F40' and l.split()[3]=='01')))" )
    result = run("docker", "exec", AUDIO[-1].container, "python", "-c", code, timeout=10, check=False)
    try:
        value = json.loads(result.stdout)
        return value if result.returncode == 0 and type(value) is int and value >= 0 else None
    except (ValueError, TypeError):
        return None


def ensure_live_idle(force=False):
    if force:
        return
    for attempt in range(2):
        count = live_connections()
        if count is None or count > 0:
            raise RuntimeError("Live has open/uncheckable connections; finish the recording first. --force interrupts the live preview")
        if attempt == 0:
            time.sleep(0.2)


def graceful_stop(service, timeout, force=False):
    if not is_running(inspect(service)):
        return
    if service.key == "wlk":
        ensure_live_idle(force)
    # Docker sends the configured stop signal, closes admission in Uvicorn, and
    # waits for in-flight file requests. -1 disables Docker's SIGKILL deadline.
    # A client timeout does not undo shutdown; never restart a draining server.
    print("Stopping " + service.container + (" (forced deadline)" if force else " (graceful drain)"), flush=True)
    try:
        run("docker", "stop", "--timeout=30" if force else "--timeout=-1", service.container,
            timeout=timeout)
    except (subprocess.TimeoutExpired, KeyboardInterrupt) as error:
        raise DrainInProgress(service.container + " is still stopping/draining; check status before retrying. " + ("Forced kill deadline may still apply." if force else "No SIGKILL deadline was set.")) from error
    if is_running(inspect(service)):
        raise DrainInProgress(service.container + " did not stop; inspect status before retrying")


def control_live_diarization(action, force=False, timeout=180, dry_run=False):
    with locked():
        guard_disk()
        before = {s.key: inspect(s) for s in AUDIO}
        selected = AUDIO if action == "start" else tuple(reversed(AUDIO[2:]))
        if action not in ("start", "stop"):
            raise ValueError("Live diarization supports start or stop")
        if any(before[s.key] is None for s in selected):
            raise RuntimeError("Required existing live containers are missing; deploy shared audio first")
        if action == "start":
            cmd = before["wlk"].get("cmd") or []
            if "--diarization" not in cmd or arg_value(cmd, ("--diarization-backend",), "") != "sortformer":
                raise RuntimeError("WLK is not configured for Sortformer")
            large = [m for m in MODELS if m.key != "small" and is_running(inspect(m))]
            if large and not force and (len(large) != 1 or large[0].key != "uncensored-asr" or not live_cpu_only(before["wlk"])):
                raise RuntimeError("Live with 27B requires the 32K ASR profile and CPU-only Sortformer; use audio for small 9B")
            needed = (3072 if not is_running(before["whisper"]) else 0)
            if not is_running(before["wlk"]) and not live_cpu_only(before["wlk"]):
                needed += 2048
            if needed:
                guard_free_vram(needed, "Live stack", force)
        if action == "stop" and is_running(before["wlk"]):
            ensure_live_idle(force)
        if dry_run:
            print("DRY RUN: " + action + " " + ", ".join(s.container for s in selected) + "; Qwen unchanged")
            return
        # Preserve existing services on failure; stop only newly started ones.
        started = []
        try:
            for service in selected:
                if action == "stop":
                    graceful_stop(service, timeout, force)
                else:
                    if not is_running(inspect(service)):
                        run("docker", "start", service.container)
                        started.append(service)
                    wait_audio(service, timeout)
        except (Exception, KeyboardInterrupt):
            if action == "start":
                for service in reversed(started):
                    try:
                        graceful_stop(service, timeout, force)
                    except Exception as error:
                        print("WARNING: rollback incomplete: " + str(error), file=sys.stderr)
                        break  # Keep dependencies for a still-running/draining client.
            raise
        print("Live diarization " + ("ready" if action == "start" else "stopped") + "; Qwen and file diarization unchanged.")


def guard_disk():
    mounted = run("findmnt", "-rn", "-M", "/mnt/datadrive", "-t", "ext4", "-O", "rw", "-o", "UUID").stdout.strip()
    if mounted != DISK_UUID:
        raise RuntimeError("Expected writable data disk is not mounted; no changes made.")


def wait_audio(service, timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        info = inspect(service)
        if not is_running(info) or info["state"].get("Restarting"):
            raise RuntimeError(f"Audio service failed to start: {service.container}")
        health = info["state"].get("Health")
        if health is None or health.get("Status") == "healthy":
            return
        if health.get("Status") == "unhealthy":
            raise RuntimeError(f"Audio service is unhealthy: {service.container}")
        time.sleep(1)
    raise RuntimeError(f"Audio readiness timeout: {service.container}")


def restore_workload(models_before, audio_before, timeout):
    # Free audio VRAM before restoring a previously selected large model.
    for service in reversed(AUDIO):
        if is_running(inspect(service)) and not is_running(audio_before[service.key]):
            graceful_stop(service, timeout)
    for model in MODELS:
        current = inspect(model)
        original = models_before[model.key]
        if current and is_running(current) and not is_running(original):
            set_restart(model, "no")
            run("docker", "stop", "-t", "30", model.container, timeout=45)
        if current:
            set_restart(model, policy_string(original) if original else "no")
    for model in MODELS:
        if is_running(models_before[model.key]):
            if not is_running(inspect(model)):
                run("docker", "start", model.container)
            wait_ready(model, timeout)
    for service in AUDIO:
        original = audio_before[service.key]
        set_restart(service, policy_string(original))
        if is_running(original):
            if not is_running(inspect(service)):
                run("docker", "start", service.container)
            wait_audio(service, timeout)


def switch_workload(mode, target=None, force=False, timeout=180, dry_run=False):
    """Change only known Qwen/audio containers, restoring both on failure."""
    if mode not in ("audio", "big", "big-asr", "big-audio"):
        raise ValueError("Unknown workload mode")
    target = target or resolve({"audio": "small", "big": "u64", "big-asr": "u32asr", "big-audio": "u32asr"}[mode])
    if (mode == "audio") != (target.key == "small") or (mode in ("big-asr", "big-audio") and target.key != "uncensored-asr"):
        raise ValueError("audio requires small; big-asr requires u32asr; big requires a 27B profile")
    enabled_audio = tuple(s for s in AUDIO if mode in ("audio", "big-audio") or (mode == "big-asr" and s.key in ("whisper", "stt-proxy")))
    disabled_audio = tuple(s for s in AUDIO if s not in enabled_audio)
    with locked():
        guard_disk()
        file_before = inspect(FILE_DIARIZATION)
        if (target.key not in ("small", "uncensored-asr") or not file_bounded(file_before)) and target.key != "small" and is_running(file_before) and not force:
            raise RuntimeError("File diarization is running; stop it with qwen-switch diarization file stop before loading a 27B profile, or explicitly use --force")
        preflight(target)
        models_before = {model.key: inspect(model) for model in MODELS}
        previous = [model for model in MODELS if is_running(models_before[model.key])]
        if len(previous) > 1:
            raise RuntimeError("Multiple known models are running; run qwen-switch stop first.")
        audio_before = {service.key: inspect(service) for service in AUDIO}
        missing = [s.container for s in AUDIO if audio_before[s.key] is None]
        if missing:
            raise RuntimeError("Missing audio containers; no changes made: " + ", ".join(missing))
        cmd = audio_before["wlk"].get("cmd") or []
        if mode in ("audio", "big-audio") and ("--diarization" not in cmd or arg_value(cmd, ("--diarization-backend",), "") != "sortformer"):
            raise RuntimeError("WLK is not configured for Sortformer diarization; no changes made.")
        if mode == "big-audio":
            if not live_cpu_only(audio_before["wlk"]):
                raise RuntimeError("big-audio requires CPU-only WLK; current GPU/unknown placement is not changed automatically")
            if file_before is None or not file_bounded(file_before):
                raise RuntimeError("big-audio requires the canonical file diarizer with bounded batches 8/8/4")
        for model in previous:
            if model != target:
                ensure_idle(model, force)
        if AUDIO[-1] in disabled_audio and is_running(audio_before["wlk"]):
            ensure_live_idle(force)
        print(f"Workload: {mode}; Qwen: {SHORT_NAMES[target.key]}", flush=True)
        print("Audio: " + {"audio": "start ASR + WLK/Sortformer", "big": "stop ASR + WLK/Sortformer to free VRAM",
                           "big-asr": "keep Whisper ASR; stop live diarization",
                           "big-audio": "Whisper GPU + file GPU + live Sortformer CPU"}[mode], flush=True)
        if dry_run:
            print("DRY RUN: preflight passed; containers and restart policies unchanged.")
            return
        try:
            for model in MODELS:
                if model != target and models_before[model.key]:
                    set_restart(model, "no")
            if disabled_audio:
                for service in reversed(disabled_audio):
                    graceful_stop(service, timeout, force)
                    set_restart(service, "no")
            switch_to(target, force, timeout, False, lock_held=True)
            set_restart(target, "unless-stopped")
            if enabled_audio:
                for service in enabled_audio:
                    set_restart(service, "unless-stopped")
                    if not is_running(inspect(service)):
                        if service.key == "whisper":
                            guard_free_vram(3072, "Whisper", force)
                        elif service.key == "wlk" and not live_cpu_only(audio_before["wlk"]):
                            guard_free_vram(2048, "Live GPU Sortformer", force)
                        print("Starting " + service.container, flush=True)
                        run("docker", "start", service.container)
                    wait_audio(service, timeout)
            if mode == "big-audio":
                if not is_running(file_before):
                    guard_file_start(force)
                    run("docker", "start", FILE_DIARIZATION.container)
                wait_file_diarization(timeout)
                set_restart(FILE_DIARIZATION, "unless-stopped")
        except DrainInProgress:
            print("Shutdown still in progress; no automatic restart/rollback attempted.", file=sys.stderr)
            raise
        except (Exception, KeyboardInterrupt):
            print("Workload switch failed; restoring previous Qwen and audio state...", file=sys.stderr, flush=True)
            try:
                if file_before is not None:
                    if not is_running(file_before) and is_running(inspect(FILE_DIARIZATION)):
                        graceful_stop(FILE_DIARIZATION, timeout)
                    set_restart(FILE_DIARIZATION, policy_string(file_before))
                restore_workload(models_before, audio_before, timeout)
            except (Exception, KeyboardInterrupt) as error:
                print(f"WARNING: workload rollback incomplete: {error}", file=sys.stderr)
            raise
        print(f"Workload ready: {mode}. Restart policies preserve this selection.", flush=True)


def stop_all(force=False, dry_run=False):
    with locked():
        snapshot = [(model, inspect(model)) for model in MODELS]
        for model, info in snapshot:
            if is_running(info):
                ensure_idle(model, force)
        for model, info in snapshot:
            if not info:
                continue
            if dry_run:
                print(f"DRY RUN: restart=no, stop {model.container}")
                continue
            set_restart(model, "no")
            if is_running(info):
                run("docker", "stop", "-t", "30", model.container, timeout=45)
        print("DRY RUN: no changes." if dry_run else "All known Qwen profiles stopped. Auto-restart disabled.")


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Qwen and audio services on faeon / RTX 4090. No arguments opens the menu.",
        epilog=HELP_NOTES, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("choice", nargs="?", help=f"audio, big-audio, big-asr, big [profile], 1..{len(MODELS)}, {', '.join(SHORT_NAMES.values())}, status/list, memory, processes, diarization [live|file] [status|start|stop], stop/off, toggle, help")
    parser.add_argument("profile", nargs="?", help="profile for big, or live/file/status/start for diarization")
    parser.add_argument("action", nargs="?", help="diarization live/file: status/start/stop")
    parser.add_argument("--force", action="store_true", help="allow interruption of active/uncheckable jobs or override GPU coexistence guards")
    parser.add_argument("--dry-run", action="store_true", help="validate the selected profile without changing containers")
    parser.add_argument("--timeout", type=int, default=180, help="readiness timeout in seconds (default: 180)")
    args = parser.parse_args(argv)
    if args.profile and args.choice not in ("big", "b", "diarization"):
        parser.error("a second argument is only valid with big or diarization")
    if args.choice == "diarization" and args.profile not in (None, "status", "start", "live", "file"):
        parser.error("diarization supports status/start or live/file [action]")
    if args.action and (args.choice != "diarization" or args.profile not in ("live", "file")):
        parser.error("a third argument is only valid with diarization live/file")
    if args.action not in (None, "status", "start", "stop"):
        parser.error("live/file support status/start/stop")
    if args.timeout < 1 or args.timeout > 900:
        parser.error("--timeout must be between 1 and 900")
    if args.choice == "help":
        parser.print_help()
        return 0
    run("docker", "info", "--format", "{{.ServerVersion}}", timeout=15)
    choice = args.choice
    if choice is None:
        show_status()
        print("\n a) Audio: Whisper ASR + WLK/Sortformer + small 9B\n f) Big-Audio: 27B/32K + Whisper + file GPU + live CPU\n w) Big-ASR: 27B/32K + Whisper ASR, live diarization off\n b) Big: one 27B model (u64), Whisper/live off\n d) Diarization status\n m) Memory\n p) Active processes\n 0) Stop all Qwen profiles (keep audio state)\n q) Quit without changes\n")
        try:
            choice = input("Select a number or name: ").strip().lower()
        except EOFError:
            print("\nNo input - no changes.")
            return 0
        if not choice or choice in ("q", "quit", "exit"):
            return 0
    if choice == "help":
        parser.print_help()
    elif choice in ("status", "list"):
        show_status()
    elif choice in ("memory", "m"):
        show_resources()
    elif choice in ("processes", "p"):
        show_resources(full=True)
    elif choice in ("diarization", "d"):
        action = args.action or ("start" if args.profile == "start" else "status")
        if args.profile == "file" and action != "status":
            control_file_diarization(action, args.force, args.timeout, args.dry_run)
        elif action in ("start", "stop"):
            control_live_diarization(action, args.force, args.timeout, args.dry_run)
        else:
            show_diarization()
    elif choice in ("stop", "off", "0"):
        stop_all(args.force, args.dry_run)
    elif choice in ("audio", "a"):
        switch_workload("audio", force=args.force, timeout=args.timeout, dry_run=args.dry_run)
    elif choice in ("big", "b"):
        switch_workload("big", resolve(args.profile or "u64"), args.force, args.timeout, args.dry_run)
    elif choice in ("big-audio", "f"):
        switch_workload("big-audio", force=args.force, timeout=args.timeout, dry_run=args.dry_run)
    elif choice in ("big-asr", "w"):
        switch_workload("big-asr", force=args.force, timeout=args.timeout, dry_run=args.dry_run)
    else:
        if choice == "toggle":
            # Preserve the old explicit toggle command; no-argument mode is now a menu.
            choice = "heretic" if is_running(inspect(MODELS[0])) else "normal"
        target = resolve(choice)
        mode = "audio" if target.key == "small" else "big-asr" if target.key == "uncensored-asr" else "big"
        switch_workload(mode, target, args.force, args.timeout, args.dry_run)
    return 0


if __name__ == "__main__":
    def interrupted(signum, frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, interrupted)
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\nCancelled.", file=sys.stderr)
        sys.exit(130)
    except (RuntimeError, ValueError, OSError, subprocess.TimeoutExpired) as error:
        print(f"Error: {error}", file=sys.stderr)
        sys.exit(1)
