def format_context(value):
    try:
        tokens = int(value)
    except (ValueError, TypeError):
        return str(value)
    if tokens < 1024:
        return str(tokens)
    return f"{tokens / 1024:.1f}".rstrip("0").rstrip(".") + "K"


def run(*args, timeout=60, check=True):
    result = subprocess.run(args, text=True, capture_output=True, timeout=timeout)
    if check and result.returncode:
        detail = (result.stderr or result.stdout).strip()[-1500:]
        raise RuntimeError(f"Command failed: {' '.join(args)}\n{detail}")
    return result


def inspect(model):
    fmt = '{"state":{{json .State}},"restart":{{json .HostConfig.RestartPolicy}},"cmd":{{json .Config.Cmd}},"networks":{{json .NetworkSettings.Networks}},"env":{{json .Config.Env}},"entrypoint":{{json .Config.Entrypoint}},"devices":{{json .HostConfig.DeviceRequests}}}'
    result = run("docker", "inspect", "--format", fmt, model.container, check=False)
    if result.returncode != 0:
        return None
    info = json.loads(result.stdout)
    # Keep only placement/batching settings; credentials never enter status output.
    allowed = {"CUDA_VISIBLE_DEVICES", "NVIDIA_VISIBLE_DEVICES",
               "DIARIZATION_SEGMENTATION_BATCH_SIZE", "DIARIZATION_EMBEDDING_BATCH_SIZE",
               "DIARIZATION_SEGMENT_EMBEDDING_BATCH_SIZE", "DIARIZATION_REQUEST_CONCURRENCY",
               "DIARIZATION_MAX_QUEUED_REQUESTS"}
    info["env"] = {k: v for k, v in (item.split("=", 1) for item in info.get("env", [])
                                    if "=" in item) if k in allowed}
    return info


def api(model, path, payload=None, timeout=2, raw=False):
    data = None if payload is None else json.dumps(payload).encode()
    req = urllib.request.Request(
        f"http://127.0.0.1:{model.port}{path}", data=data,
        headers={"Content-Type": "application/json"} if data else {},
    )
    try:
        with OPENER.open(req, timeout=timeout) as response:
            body = response.read().decode()
            return body if raw else json.loads(body)
    except (OSError, ValueError, urllib.error.URLError):
        return None


def is_running(info):
    return bool(info and info["state"].get("Running"))


def arg_value(args, names, default):
    for index, item in enumerate(args or []):
        if item in names and index + 1 < len(args):
            return args[index + 1]
    return default


def status(model, info):
    if info is None:
        return "NOT CREATED", None
    state = info["state"].get("Status", "unknown")
    if state != "running":
        return {"exited": "STOPPED", "created": "CREATED", "restarting": "RESTARTING"}.get(state, state.upper()), None
    props = api(model, "/props")
    if isinstance(props, dict) and props.get("is_sleeping") is True:
        return "SLEEPING", props
    health = api(model, "/health")
    if isinstance(health, dict) and health.get("status") == "ok":
        if isinstance(props, dict) and props.get("is_sleeping") is False:
            return "LOADED", props
        return "API READY", props
    return "NOT READY", props


def display_args(model, info):
    if info is not None:
        return info.get("cmd") or []
    if model.compose and (ROOT / model.compose).is_file():
        result = run("docker", "compose", "-f", str(ROOT / model.compose), "config", "--format", "json", check=False)
        if result.returncode == 0:
            try:
                return json.loads(result.stdout)["services"]["llama"]["command"]
            except (ValueError, KeyError):
                pass
    return []


def parameter_values(model, args, props=None):
    ctx = arg_value(args, ("--ctx-size", "-c"), model.context)
    runtime_ctx = (props or {}).get("default_generation_settings", {}).get("n_ctx")
    if isinstance(runtime_ctx, int) and runtime_ctx > 0:
        ctx = runtime_ctx
    ctx = format_context(ctx)
    key_cache = arg_value(args, ("--cache-type-k", "-ctk"), model.cache)
    value_cache = arg_value(args, ("--cache-type-v", "-ctv"), model.cache)
    cache = key_cache if key_cache == value_cache else f"{key_cache}/{value_cache}"
    spec = arg_value(args, ("--spec-type",), "none")
    draft = arg_value(args, ("--spec-draft-n-max",), "3")
    spec_name = {"draft-mtp": "MTP", "draft-dflash": "DFlash", "dflash": "DFlash"}.get(spec, spec)
    spec_text = f"{spec_name}:{draft}" if spec != "none" else "none"
    if spec == "dflash" and "--spec-dm-adaptive" in args:
        spec_text += "A"
    vision = "off"
    if "--mmproj" in args and "--no-mmproj" not in args:
        vision = "CPU" if "--no-mmproj-offload" in args else "GPU"
    batch = arg_value(args, ("--batch-size", "-b"), "2048")
    ubatch = arg_value(args, ("--ubatch-size", "-ub"), "512")
    threads = arg_value(args, ("--threads", "-t"), "auto")
    threads_batch = arg_value(args, ("--threads-batch", "-tb"), threads)
    idle = arg_value(args, ("--sleep-idle-seconds",), "0")
    idle_text = "off" if str(idle) in ("0", "-1") else f"{idle}s"
    return (str(ctx), str(cache), spec_text, vision, f"{batch}/{ubatch}",
            f"{threads}/{threads_batch}", idle_text, str(model.port))


def format_table(headers, rows):
    widths = [max(len(str(row[index])) for row in [headers, *rows])
              for index in range(len(headers))]

    def line(row):
        return " " + "  ".join(str(value).ljust(width) for value, width in zip(row, widths)).rstrip()

    return [line(headers), line(tuple("-" * width for width in widths)),
            *(line(row) for row in rows)]


def model_name(model, args, props=None):
    path = (props or {}).get("model_path") or arg_value(args, ("--model", "-m"), model.model_filename)
    return Path(path).name.removesuffix(".gguf")


