def whisper_readiness(info):
    if not is_running(info):
        return "STOPPED" if info else "MISSING"
    for network in (info.get("networks") or {}).values():
        address = network.get("IPAddress")
        if not address:
            continue
        try:
            with OPENER.open(f"http://{address}:9000/health", timeout=2) as response:
                value = json.load(response)
            if value.get("status") == "ready":
                return "READY / " + str(value.get("model_state", "model state unknown"))
        except (OSError, ValueError, urllib.error.URLError):
            continue
    return "RUNNING / readiness unknown"


def resource_module():
    # Resolve the user-bin symlink so helpers always belong to the deployed project.
    path = Path(__file__).resolve().with_name("qwen_resources.py")
    spec = importlib.util.spec_from_file_location("qwen_resources", path)
    if spec is None or spec.loader is None:
        raise RuntimeError("qwen_resources.py is missing beside the maintained qwen-switch")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def loaded_vram_plan(running, audio):
    low = high = 0.0
    unknown = False
    for model in running:
        text = MEMORY_ESTIMATES.get(model.key, ("?", "?"))[0]
        try:
            values = [float(value) for value in text.split("-")]
            low += values[0]
            high += values[-1]
        except ValueError:
            unknown = True
    if is_running(audio.get("whisper")):
        low += 2.5
        high += 2.5
    if is_running(audio.get("wlk")) and not live_cpu_only(audio["wlk"]):
        low += 1.4
        high += 1.4
    estimate = f"{low:.1f}" if low == high else f"{low:.1f}-{high:.1f}"
    return estimate + (" + unknown" if unknown else "")


def show_resources(full=False, running=None, audio=None):
    running = running if running is not None else [m for m in MODELS if is_running(inspect(m))]
    audio = audio if audio is not None else {s.key: inspect(s) for s in AUDIO}
    known = {m.container for m in MODELS} | {s.container for s in AUDIO} | OMI_CONTAINERS | {FILE_DIARIZATION.container}
    module = resource_module()
    snapshot = module.collect_resources(known)
    states = {c["name"]: c["state"] for c in snapshot["containers"]}
    active_states = {"running", "restarting", "paused"}
    settled_states = active_states | {"exited", "created", "dead", "missing"}
    running = [m for m in MODELS if states.get(m.container) in active_states]
    planned_audio = {s.key: {**(audio.get(s.key) or {}), "state": {"Running": states.get(s.container) in active_states}} for s in AUDIO}
    uncertain = any(states.get(s.container) not in settled_states for s in (*MODELS, *AUDIO, FILE_DIARIZATION))
    print(module.render_resources(snapshot, full=full))
    if not full:
        extra = " + file GPU ~1.0 (observed, peak unknown)" if states.get(FILE_DIARIZATION.container) in active_states else ""
        if uncertain:
            extra += " + unknown selection"
        print(f" Loaded model VRAM~GiB: current selection {loaded_vram_plan(running, planned_audio)}{extra}.")
        print(" Add other GPU usage; loaded RAM/VRAM peaks are not guaranteed. Details: qwen-switch help.")


