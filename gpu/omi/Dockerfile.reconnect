# Before building, verify this local base has image ID
# sha256:c8b35eacf0c97aac57575be9d714c54a2888bed957fce9ddefc8b728ade8d26f.
ARG OMI_RECONNECT_BASE_IMAGE=mycelia/omiloc-app-audio-compat-r4:2026-10-01
FROM ${OMI_RECONNECT_BASE_IMAGE}
USER root
COPY live_reconnect.py /opt/omiloc/scripts/dev-harness/dev_harness/live_reconnect.py
COPY patch_live_reconnect.py /tmp/patch_live_reconnect.py
RUN python /tmp/patch_live_reconnect.py \
      /opt/omiloc/scripts/dev-harness/dev_harness/local_provider_relay.py \
      /opt/omiloc/backend/utils/local_live_preview.py \
    && rm /tmp/patch_live_reconnect.py
USER omi
