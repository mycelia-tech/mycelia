#!/usr/bin/env -S deno run --quiet --allow-read --allow-run=/usr/bin/security,/usr/bin/id --allow-env=MYCELIA_BACKUP_COMPOSE_ROOT,HOME
import { passwordCommandMain } from "./backup/restic.ts";

if (import.meta.main) {
  Deno.exit(await passwordCommandMain(Deno.args, {
    MYCELIA_BACKUP_COMPOSE_ROOT: Deno.env.get("MYCELIA_BACKUP_COMPOSE_ROOT"),
    HOME: Deno.env.get("HOME"),
  }));
}
