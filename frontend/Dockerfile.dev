# Development Dockerfile - watches and rebuilds with hot reload
FROM denoland/deno:2.9.5@sha256:b429777c3dcff34a6488f365a1537db1640b2d48379b60f5e6206be034472463

ENV DENO_DIR=/deno-dir
ENV NODE_ENV=development

WORKDIR /app

# Copy lockfiles and config first for better caching
COPY ./frontend/deno.json ./frontend/deno.lock ./frontend/package.json ./

# Resolve the complete locked dependency graph before the bind-mounted source
# starts Vite so container recreation does not reinstall application packages.
RUN deno install --frozen

# Copy myceliasdk for import resolution
COPY ./myceliasdk ./myceliasdk

# Source files will be mounted as a volume for hot reload
# COPY ./frontend .  # Not needed - volume mount in docker-compose

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 \
  CMD deno eval "const response = await fetch('http://127.0.0.1:8080/'); if (!response.ok) Deno.exit(1);"

# Run dev server on port 8080 with host binding for Docker
# Vite handles HMR internally - no need for deno --watch
CMD ["deno", "run", "-A", "npm:vite", "--host", "0.0.0.0", "--port", "8080"]
