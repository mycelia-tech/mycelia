# ---------- Builder (Deno) ----------
FROM denoland/deno:2.9.5@sha256:b429777c3dcff34a6488f365a1537db1640b2d48379b60f5e6206be034472463 AS builder

ENV DENO_DIR=/deno-dir
ENV NODE_ENV=production

WORKDIR /app

# Copy lockfiles and config first for better caching
COPY ./frontend/deno.json ./frontend/deno.lock ./frontend/package.json ./

# Resolve the complete locked dependency graph before source is copied so
# ordinary application edits keep this expensive layer cached.
RUN deno install --frozen

# Copy the rest of the source
COPY ./frontend .
# Copy myceliasdk INTO the app directory for Docker build (so it can access node_modules)
COPY ./myceliasdk ./myceliasdk

# Build static assets using Deno task (runs: deno run -A npm:vite build)
RUN deno task build

# ---------- Runtime (Nginx) ----------
FROM nginx:1.27-alpine AS runtime

USER root
RUN adduser -D -H -u 10001 appuser \
  && mkdir -p /var/cache/nginx \
  && chown -R appuser:appuser /var/cache/nginx /var/run /var/log/nginx

COPY --from=builder /app/dist /usr/share/nginx/html
COPY ./frontend/nginx.conf /etc/nginx/nginx.conf

USER appuser
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/ >/dev/null 2>&1 || exit 1

CMD ["nginx", "-g", "daemon off;"]
