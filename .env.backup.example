# Non-secret backup configuration. Copy to .env.backup; it is never sourced.
# Credential material belongs in Keychain, not this file.
BACKUP_RCLONE_REMOTE=pk-backup:
BACKUP_REMOTE_ROOT=pk-backup:mycelia
BACKUP_RESTIC_REPOSITORY=rclone:pk-backup:mycelia/restic-v1
# Keychain lookup labels only; no passphrase is stored here.
BACKUP_RESTIC_KEYCHAIN_SERVICE=tech.mycelia.backup.restic
BACKUP_RESTIC_KEYCHAIN_ACCOUNT=mycelia
# 10 GiB floor; later preflight also accounts for measured source sizes.
BACKUP_REMOTE_MIN_FREE_BYTES=10737418240
# Explicitly reviewed repository-relative operational files; empty by default.
BACKUP_OPERATIONAL_UNTRACKED_JSON=[]
# State and lock are local to the selected compose root: .local/backup/.
# The empty backup.lock.guard file stays in place; ownership is an OS advisory
# lock released on process exit. Do not delete or replace that guard file.
# A dead lock requires backupctl <command> --compose-root <absolute-path>
# --clear-stale-lock <pid>. Live or mismatched PIDs are never removed.
